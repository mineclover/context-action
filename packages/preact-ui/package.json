{
  "name": "@context-action/preact-ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Owned Preact DOM roots and template mounting primitives",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react-bridge": {
      "import": {
        "types": "./dist/react-bridge.d.ts",
        "default": "./dist/react-bridge.js"
      },
      "require": {
        "types": "./dist/react-bridge.d.cts",
        "default": "./dist/react-bridge.cjs"
      }
    },
    "./ssr": {
      "import": {
        "types": "./dist/ssr.d.ts",
        "default": "./dist/ssr.js"
      },
      "require": {
        "types": "./dist/ssr.d.cts",
        "default": "./dist/ssr.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "examples:dev": "pnpm build:standalone && pnpm sync:standalone && vite --config examples/vite.config.ts",
    "examples:build": "pnpm build:standalone && pnpm sync:standalone && vite build --config examples/vite.config.ts --outDir ../example-dist",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "sync:standalone": "node scripts/sync-standalone.mjs",
    "test:native": "tsc --ignoreConfig src/ownership.ts src/disposal-scope.ts --target ES2022 --module ES2022 --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --outDir .native-check && node --test test/native-contract.test.mjs",
    "test:browser": "pnpm build && pnpm build:standalone && pnpm sync:standalone && node test/browser-contract.test.mjs",
    "test:browser:cross": "node test/browser-cross-contract.test.mjs"
  },
  "dependencies": {
    "@context-action/preact": "^0.1.0"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.27.3",
    "react": "^18.0.0 || ^19.0.0",
    "preact-render-to-string": "^6.7.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "preact-render-to-string": {
      "optional": true
    }
  },
  "devDependencies": {
    "@context-action/core": "workspace:*",
    "@preact/signals": "2.11.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "preact": "10.27.3",
    "preact-render-to-string": "6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
