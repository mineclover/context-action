{
  "name": "@context-action/preact-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Owned Preact DOM roots and template mounting primitives",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "examples:dev": "vite examples",
    "examples:build": "vite build examples --outDir ../example-dist",
    "test:native": "tsc --ignoreConfig src/ownership.ts src/disposal-scope.ts --target ES2022 --module ES2022 --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --outDir .native-check && node --test test/native-contract.test.mjs"
  },
  "dependencies": {
    "@context-action/preact": "workspace:*"
  },
  "peerDependencies": {
    "preact": "^10.27.3",
    "@preact/signals": "^2.11.2"
  },
  "devDependencies": {
    "preact": "10.27.3",
    "@preact/signals": "2.11.2",
    "tsdown": "0.22.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "@context-action/core": "workspace:*",
    "@types/node": "24.13.3",
    "jsdom": "26.1.0",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
