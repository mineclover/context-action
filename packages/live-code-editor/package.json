{
  "name": "@context-action/live-code-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace runtime and browser contracts for Context-Action live code editors",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm exec biome check src",
    "test": "pnpm build && node --test test/index.test.mjs",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsdown": "0.22.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
