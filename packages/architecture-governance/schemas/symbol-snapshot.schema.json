{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/symbol-snapshot.schema.json",
  "title": "Context-Action Symbol Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "repositoryRoot", "revision", "projects", "projectStatuses", "symbols"],
  "properties": {
    "contractId": { "const": "context-action/symbol-snapshot" },
    "contractVersion": { "const": "1.1" },
    "repositoryRoot": { "$ref": "#/$defs/text" },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/$defs/text" },
        "gitHead": { "$ref": "#/$defs/text" },
        "workingTreeDigest": { "$ref": "#/$defs/text" }
      },
      "anyOf": [
        { "required": ["commit"], "properties": { "commit": { "$ref": "#/$defs/text" } } },
        { "required": ["gitHead"], "properties": { "gitHead": { "$ref": "#/$defs/text" } } },
        { "required": ["workingTreeDigest"], "properties": { "workingTreeDigest": { "$ref": "#/$defs/text" } } }
      ]
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "root": { "$ref": "#/$defs/text" },
          "fileExtensions": { "$ref": "#/$defs/fileExtensions" }
        }
      }
    },
    "projectStatuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "root", "status"],
        "properties": {
          "projectId": { "$ref": "#/$defs/text" },
          "root": { "$ref": "#/$defs/text" },
          "status": { "enum": ["analyzed", "skipped"] },
          "reason": { "const": "missing-at-revision" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "skipped" } } },
            "then": { "properties": { "reason": { "const": "missing-at-revision" } }, "required": ["reason"] }
          },
          {
            "if": { "properties": { "status": { "const": "analyzed" } } },
            "then": { "properties": { "status": { "const": "analyzed" } }, "not": { "required": ["reason"] } }
          }
        ]
      }
    },
    "symbols": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "entityId", "filePath", "symbol", "kind", "name", "startLine", "endLine"],
        "properties": {
          "projectId": { "$ref": "#/$defs/text" },
          "entityId": { "$ref": "#/$defs/text" },
          "filePath": { "$ref": "#/$defs/text" },
          "symbol": { "$ref": "#/$defs/text" },
          "kind": { "$ref": "#/$defs/text" },
          "name": { "$ref": "#/$defs/text" },
          "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "parentId": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "fileExtensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9][a-z0-9._-]*$",
        "maxLength": 64
      }
    }
  }
}
