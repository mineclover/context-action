{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/symbol-history.schema.json",
  "title": "Context-Action Symbol History Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "generatedAt", "repositoryRoot", "range", "commits", "summary"],
  "properties": {
    "contractId": { "const": "context-action/symbol-history-report" },
    "contractVersion": { "const": "1.3" },
    "generatedAt": { "$ref": "#/$defs/text" },
    "repositoryRoot": { "$ref": "#/$defs/text" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/text" },
        "to": { "$ref": "#/$defs/text" }
      }
    },
    "commits": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit", "parent", "subject", "changes", "snapshot"],
        "properties": {
          "commit": { "$ref": "#/$defs/text" },
          "parent": { "$ref": "#/$defs/text" },
          "subject": { "$ref": "#/$defs/text" },
          "changes": {
            "type": "array",
            "maxItems": 65536,
            "items": { "$ref": "#/$defs/change" }
          },
          "snapshot": { "$ref": "#/$defs/snapshot" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "changes", "snapshotSymbols", "added", "modified", "deleted", "moved", "renamed", "reordered"],
      "properties": {
        "commits": { "$ref": "#/$defs/count" },
        "changes": { "$ref": "#/$defs/count" },
        "snapshotSymbols": { "$ref": "#/$defs/count" },
        "added": { "$ref": "#/$defs/count" },
        "modified": { "$ref": "#/$defs/count" },
        "deleted": { "$ref": "#/$defs/count" },
        "moved": { "$ref": "#/$defs/count" },
        "renamed": { "$ref": "#/$defs/count" },
        "reordered": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "fileExtensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9][a-z0-9._-]*$",
        "maxLength": 64
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeType", "entityId", "filePath", "symbol"],
      "properties": {
        "changeType": { "enum": ["added", "modified", "deleted", "moved", "renamed", "reordered"] },
        "entityId": { "$ref": "#/$defs/text" },
        "filePath": { "$ref": "#/$defs/text" },
        "symbol": { "$ref": "#/$defs/text" },
        "oldFilePath": { "$ref": "#/$defs/text" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "root": { "$ref": "#/$defs/text" },
        "fileExtensions": { "$ref": "#/$defs/fileExtensions" }
      }
    },
    "projectStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "root", "status"],
      "properties": {
        "projectId": { "$ref": "#/$defs/text" },
        "root": { "$ref": "#/$defs/text" },
        "status": { "enum": ["analyzed", "skipped"] },
        "reason": { "const": "missing-at-revision" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "skipped" } } },
          "then": { "properties": { "reason": { "const": "missing-at-revision" } }, "required": ["reason"] }
        },
        {
          "if": { "properties": { "status": { "const": "analyzed" } } },
          "then": { "properties": { "status": { "const": "analyzed" } }, "not": { "required": ["reason"] } }
        }
      ]
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "entityId", "filePath", "symbol", "kind", "name", "startLine", "endLine"],
      "properties": {
        "projectId": { "$ref": "#/$defs/text" },
        "entityId": { "$ref": "#/$defs/text" },
        "filePath": { "$ref": "#/$defs/text" },
        "symbol": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "parentId": { "$ref": "#/$defs/text" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "contractVersion", "repositoryRoot", "revision", "projects", "projectStatuses", "symbols"],
      "properties": {
        "contractId": { "const": "context-action/symbol-snapshot" },
        "contractVersion": { "const": "1.1" },
        "repositoryRoot": { "$ref": "#/$defs/text" },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": { "$ref": "#/$defs/text" },
            "gitHead": { "$ref": "#/$defs/text" },
            "workingTreeDigest": { "$ref": "#/$defs/text" }
          },
          "anyOf": [
            { "properties": { "commit": { "$ref": "#/$defs/text" } }, "required": ["commit"] },
            { "properties": { "gitHead": { "$ref": "#/$defs/text" } }, "required": ["gitHead"] },
            { "properties": { "workingTreeDigest": { "$ref": "#/$defs/text" } }, "required": ["workingTreeDigest"] }
          ]
        },
        "projects": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/project" } },
        "projectStatuses": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/projectStatus" } },
        "symbols": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/symbol" } }
      }
    }
  }
}
