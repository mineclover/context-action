{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:context-action:architecture-governance:policy-set:1",
  "title": "Context-Action Architecture Policy Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "anyOf": [
    {
      "required": ["packageBoundaries"],
      "properties": {
        "packageBoundaries": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["impactBoundaries"],
      "properties": {
        "impactBoundaries": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonEmptyString" },
    "schemaVersion": { "const": 1 },
    "packageBoundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/packageBoundary" }
    },
    "impactBoundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/impactBoundary" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "globPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "globPatternSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/globPattern" }
    },
    "severity": {
      "enum": ["error", "warning", "info"]
    },
    "packageBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from"],
      "anyOf": [
        {
          "required": ["disallow"],
          "properties": {
            "disallow": { "$ref": "#/$defs/nonEmptyStringSet" }
          }
        },
        {
          "required": ["require"],
          "properties": {
            "require": { "$ref": "#/$defs/nonEmptyStringSet" }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "project": { "$ref": "#/$defs/nonEmptyString" },
        "from": { "$ref": "#/$defs/nonEmptyString" },
        "disallow": { "$ref": "#/$defs/nonEmptyStringSet" },
        "require": { "$ref": "#/$defs/nonEmptyStringSet" },
        "dependencyFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dependencies",
              "devDependencies",
              "peerDependencies",
              "optionalDependencies"
            ]
          }
        },
        "severity": { "$ref": "#/$defs/severity" }
      }
    },
    "impactBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "disallowDependencies"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "project": { "$ref": "#/$defs/nonEmptyString" },
        "from": { "$ref": "#/$defs/globPatternSet" },
        "disallowDependencies": { "$ref": "#/$defs/globPatternSet" },
        "severity": { "$ref": "#/$defs/severity" },
        "missingEvidenceSeverity": { "$ref": "#/$defs/severity" }
      }
    }
  }
}
