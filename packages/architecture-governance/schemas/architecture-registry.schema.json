{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:context-action:architecture-governance:registry:1",
  "title": "Context-Action Architecture Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonEmptyString" },
    "schemaVersion": { "const": 1 },
    "repository": { "$ref": "#/$defs/nonEmptyString" },
    "analysisProjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/project" }
    },
    "policyFiles": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "stringSet": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "root": { "$ref": "#/$defs/nonEmptyString" },
        "fileExtensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^\\.[a-z0-9][a-z0-9._-]*$"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "spec",
        "owners",
        "implementationAnchors",
        "testEvidence",
        "publicDocs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^CA-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "status": {
          "enum": ["planned", "implemented", "verified", "deprecated"]
        },
        "project": { "$ref": "#/$defs/nonEmptyString" },
        "spec": { "$ref": "#/$defs/nonEmptyString" },
        "owners": { "$ref": "#/$defs/stringSet" },
        "implementationAnchors": { "$ref": "#/$defs/stringSet" },
        "testEvidence": { "$ref": "#/$defs/stringSet" },
        "publicDocs": { "$ref": "#/$defs/stringSet" },
        "decisions": { "$ref": "#/$defs/stringSet" },
        "rules": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}
