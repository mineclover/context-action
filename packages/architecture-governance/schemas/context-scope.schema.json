{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/context-scope.schema.json",
  "title": "Context-Action Context Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "context", "source", "anchors", "nodes", "edges", "groups", "status"],
  "properties": {
    "contractId": { "const": "context-action/context-scope" },
    "contractVersion": { "const": "1.0" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["screen", "api", "transaction", "workflow", "document"] },
        "label": { "$ref": "#/$defs/text" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "manifest"],
      "properties": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractId", "contractVersion", "revision"],
          "properties": {
            "contractId": { "const": "context-action/symbol-snapshot" },
            "contractVersion": { "const": "1.1" },
            "revision": { "$ref": "#/$defs/revision" }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "contentDigest"],
          "properties": {
            "path": { "$ref": "#/$defs/text" },
            "contentDigest": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/anchor" }
    },
    "nodes": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/symbolRef" }
    },
    "edges": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/edge" }
    },
    "groups": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/group" }
    },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "appliedLimits"],
          "properties": {
            "kind": { "const": "complete" },
            "appliedLimits": { "$ref": "#/$defs/limits" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "appliedLimits", "reasons"],
          "properties": {
            "kind": { "const": "incomplete" },
            "appliedLimits": { "$ref": "#/$defs/limits" },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["depth", "nodes", "edges", "groups", "budget", "evidence-unavailable"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "errors"],
          "properties": {
            "kind": { "const": "invalid" },
            "errors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["anchor-unresolved", "manifest-revision-mismatch", "unsupported-profile"] }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "commit": { "$ref": "#/$defs/text" },
        "gitHead": { "$ref": "#/$defs/text" },
        "workingTreeDigest": { "$ref": "#/$defs/text" }
      }
    },
    "symbolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "filePath", "entityId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/text" },
        "filePath": { "$ref": "#/$defs/text" },
        "entityId": { "$ref": "#/$defs/text" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "symbol"],
      "properties": {
        "role": { "enum": ["root", "view", "endpoint", "controller", "trigger", "state-read", "state-write", "command", "step", "definition", "reference"] },
        "symbol": { "$ref": "#/$defs/symbolRef" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "evidence"],
      "properties": {
        "from": { "$ref": "#/$defs/text" },
        "to": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["depends-on", "invokes", "reads", "writes", "renders", "validates", "documents"] },
        "evidence": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "relation"],
              "properties": {
                "provider": { "const": "sem" },
                "relation": { "enum": ["dependency", "dependent"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "declarationId"],
              "properties": {
                "provider": { "const": "manifest" },
                "declarationId": { "$ref": "#/$defs/text" }
              }
            }
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "memberNodeKeys"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["context", "layer", "module", "project"] },
        "label": { "$ref": "#/$defs/text" },
        "memberNodeKeys": {
          "type": "array",
          "maxItems": 65536,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDepth", "maxNodes", "maxEdges", "maxGroups"],
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxEdges": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxGroups": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
