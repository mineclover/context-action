{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/symbol-snapshot-diff.schema.json",
  "title": "Context-Action Symbol Snapshot Diff",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "generatedAt", "beforeRevision", "afterRevision", "added", "removed", "modified"],
  "properties": {
    "contractId": { "const": "context-action/symbol-snapshot-diff" },
    "contractVersion": { "const": "1.0" },
    "generatedAt": { "$ref": "#/$defs/text" },
    "beforeRevision": { "$ref": "#/$defs/text" },
    "afterRevision": { "$ref": "#/$defs/text" },
    "added": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/symbol" } },
    "removed": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/symbol" } },
    "modified": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": { "$ref": "#/$defs/symbol" },
          "after": { "$ref": "#/$defs/symbol" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "entityId", "filePath", "symbol", "kind", "name", "startLine", "endLine"],
      "properties": {
        "projectId": { "$ref": "#/$defs/text" },
        "entityId": { "$ref": "#/$defs/text" },
        "filePath": { "$ref": "#/$defs/text" },
        "symbol": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "parentId": { "$ref": "#/$defs/text" }
      }
    }
  }
}
