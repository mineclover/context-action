{
  "name": "@context-action/mutative-core",
  "version": "0.8.8",
  "type": "module",
  "description": "Context-Action maintained Mutative core for efficient immutable updates",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:prod": "NODE_ENV=production tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "lint": "pnpm --workspace-root exec biome lint packages/mutative-core/src",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build:prod"
  },
  "keywords": [
    "mutative",
    "immer",
    "immutable",
    "copy-on-write",
    "context-action"
  ],
  "author": "mineclover",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/mutative-core"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action/tree/main/packages/mutative-core",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
