{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "types": ["jest", "node"],
    "typeRoots": ["../node_modules/@types", "../../node_modules/@types"],
    
    // Strict type checking for tests
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@context-action/react": ["src/index"],
      "@context-action/react/*": ["src/*"],
      "@context-action/core": ["../core/src/index"],
      "@context-action/core/*": ["../core/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../src/**/__tests__/**/*.ts",
    "../src/**/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}