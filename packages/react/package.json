{
  "name": "@context-action/react",
  "version": "4.0.7",
  "type": "module",
  "description": "React integration for @context-action/core - Context and hooks for type-safe action management",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./refs": {
      "import": {
        "types": "./dist/refs.d.ts",
        "default": "./dist/refs.js"
      },
      "require": {
        "types": "./dist/refs.d.cts",
        "default": "./dist/refs.cjs"
      }
    },
    "./time-travel": {
      "import": {
        "types": "./dist/time-travel.d.ts",
        "default": "./dist/time-travel.js"
      },
      "require": {
        "types": "./dist/time-travel.d.cts",
        "default": "./dist/time-travel.cjs"
      }
    },
    "./transactions": {
      "import": {
        "types": "./dist/transactions.d.ts",
        "default": "./dist/transactions.js"
      },
      "require": {
        "types": "./dist/transactions.d.cts",
        "default": "./dist/transactions.cjs"
      }
    },
    "./backend": {
      "import": {
        "types": "./dist/backend.d.ts",
        "default": "./dist/backend.js"
      },
      "require": {
        "types": "./dist/backend.d.cts",
        "default": "./dist/backend.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./webmcp": {
      "import": {
        "types": "./dist/webmcp.d.ts",
        "default": "./dist/webmcp.js"
      },
      "require": {
        "types": "./dist/webmcp.d.cts",
        "default": "./dist/webmcp.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsdown",
    "build:prod": "pnpm run build",
    "build:dev": "NODE_ENV=development tsdown",
    "build:watch": "tsdown --watch",
    "test": "jest --runInBand",
    "test:canonical-example": "jest --runInBand __tests__/patterns/implementation-playbook.integration.test.tsx",
    "test:watch": "jest --watch",
    "lint": "pnpm --workspace-root exec biome lint packages/react/src",
    "lint:fix": "pnpm --workspace-root exec biome lint --write packages/react/src",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "clean": "rimraf dist",
    "security:audit": "pnpm --workspace-root security:audit",
    "analyze": "NODE_ENV=production tsdown --analyze",
    "bundle-report": "NODE_ENV=production tsdown --report",
    "security:outdated": "pnpm outdated",
    "security:check": "pnpm security:audit && pnpm security:outdated",
    "prepublishOnly": "pnpm run build:prod"
  },
  "keywords": [
    "typescript",
    "react",
    "action",
    "pipeline",
    "state-management",
    "context",
    "hooks"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@context-action/tool-protocol": "^1.0.0",
    "@context-action/webmcp": "^0.1.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@context-action/webmcp": {
      "optional": true
    },
    "@context-action/tool-protocol": {
      "optional": true
    }
  },
  "dependencies": {
    "@context-action/core": "^1.2.6",
    "@context-action/interactions": "^0.1.0",
    "@context-action/mutative": "^0.8.15",
    "@context-action/store-core": "^0.1.3",
    "react-compiler-runtime": "1.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@context-action/tool-durable-operations": "workspace:*",
    "@context-action/tool-protocol": "workspace:*",
    "@context-action/webmcp": "workspace:*",
    "@rolldown/plugin-babel": "0.3.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.4",
    "rolldown": "1.3.3",
    "rollup-plugin-visualizer": "7.1.3",
    "tsdown": "0.23.7",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "browser": {
    "node:module": false,
    "node:path": false,
    "node:fs": false,
    "node:url": false,
    "node:crypto": false,
    "node:buffer": false
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
