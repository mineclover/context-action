{
  "name": "@context-action/react",
  "version": "0.9.1",
  "type": "module",
  "description": "React integration for @context-action/core - Context and hooks for type-safe action management",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./react18": {
      "import": {
        "types": "./dist/react18.d.ts",
        "default": "./dist/react18.js"
      },
      "require": {
        "types": "./dist/react18.d.cts",
        "default": "./dist/react18.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools/index.js"
      },
      "require": {
        "types": "./dist/tools/index.d.cts",
        "default": "./dist/tools/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsdown",
    "build:prod": "pnpm run build",
    "build:dev": "NODE_ENV=development tsdown",
    "build:watch": "tsdown --watch",
    "test": "jest",
    "test:canonical-example": "jest --runInBand __tests__/patterns/implementation-playbook.integration.test.tsx",
    "test:watch": "jest --watch",
    "lint": "pnpm --workspace-root exec biome lint packages/react/src",
    "lint:fix": "pnpm --workspace-root exec biome lint --write packages/react/src",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "clean": "rimraf dist",
    "security:audit": "pnpm --workspace-root security:audit",
    "analyze": "NODE_ENV=production tsdown --analyze",
    "bundle-report": "NODE_ENV=production tsdown --report",
    "security:outdated": "pnpm outdated",
    "security:check": "pnpm security:audit && pnpm security:outdated",
    "prepublishOnly": "pnpm run build:prod"
  },
  "keywords": [
    "typescript",
    "react",
    "action",
    "pipeline",
    "state-management",
    "context",
    "hooks"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@context-action/tool-durable-operations": "^0.1.1",
    "@context-action/tool-protocol": "^0.8.8"
  },
  "peerDependenciesMeta": {
    "@context-action/tool-durable-operations": {
      "optional": true
    },
    "@context-action/tool-protocol": {
      "optional": true
    }
  },
  "dependencies": {
    "@context-action/core": "^0.9.1",
    "@context-action/mutative": "^0.8.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.3",
    "@swc/core": "1.15.46",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@context-action/tool-durable-operations": "workspace:*",
    "@context-action/tool-protocol": "workspace:*",
    "babel-plugin-react-compiler": "1.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.0",
    "rollup-plugin-visualizer": "7.0.1",
    "tsdown": "0.22.13",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "browser": {
    "node:module": false,
    "node:path": false,
    "node:fs": false,
    "node:url": false,
    "node:crypto": false,
    "node:buffer": false
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "gitHead": "d044f181a22b8f1fc5ad3362afd30d117fedebdd"
}
