{
  "name": "@context-action/react",
  "version": "0.7.8",
  "type": "module",
  "description": "React integration for @context-action/core - Context and hooks for type-safe action management",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    },
    "./react18": {
      "import": {
        "types": "./dist/react18.d.ts",
        "default": "./dist/react18.js"
      },
      "require": {
        "types": "./dist/react18.d.cts",
        "default": "./dist/react18.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:prod": "NODE_ENV=production tsdown",
    "build:dev": "NODE_ENV=development tsdown",
    "build:watch": "tsdown --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "security:audit": "pnpm audit --audit-level high",
    "security:outdated": "pnpm outdated",
    "security:check": "pnpm security:audit && pnpm security:outdated",
    "prepublishOnly": "pnpm run build:prod"
  },
  "keywords": [
    "typescript",
    "react",
    "action",
    "pipeline",
    "state-management",
    "context",
    "hooks"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action#readme",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "@context-action/core": "^0.7.7",
    "immer": "10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/three": "0.179.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "6.0.3",
    "ts-jest": "^29.4.1",
    "tsdown": "^0.14.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browser": {
    "node:module": false,
    "node:path": false,
    "node:fs": false,
    "node:url": false,
    "node:crypto": false,
    "node:buffer": false
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
