{
  "name": "@context-action/webmcp",
  "version": "0.1.0-rc.0",
  "type": "module",
  "description": "WebMCP imperative API adapter for Context-Action tool managers",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./profiles/chrome-legacy": {
      "import": {
        "types": "./dist/profiles/chrome-legacy.d.ts",
        "default": "./dist/profiles/chrome-legacy.js"
      },
      "require": {
        "types": "./dist/profiles/chrome-legacy.d.cts",
        "default": "./dist/profiles/chrome-legacy.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "test": "jest --runInBand",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "lint": "pnpm --workspace-root exec biome lint packages/webmcp/src",
    "clean": "rimraf dist"
  },
  "keywords": ["webmcp", "mcp", "browser", "tool-calling"],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/webmcp"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@context-action/tool-protocol": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@context-action/tool-protocol": "workspace:*",
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.13",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "engines": { "node": ">=24.11.0" }
}
