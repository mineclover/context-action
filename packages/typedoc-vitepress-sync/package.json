{
  "name": "@context-action/typedoc-vitepress-sync",
  "version": "0.8.7",
  "description": "Enhanced TypeDoc to VitePress documentation sync with smart caching, parallel processing, and quality validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typedoc-vitepress-sync": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./bin/cli.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "tsdown --watch",
    "test": "jest",
    "test:performance": "jest __tests__/Performance.test.ts --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "pnpm --workspace-root exec biome lint packages/typedoc-vitepress-sync/src",
    "lint:fix": "pnpm --workspace-root exec biome lint --write packages/typedoc-vitepress-sync/src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "example:basic": "node examples/basic-usage/index.js",
    "example:advanced": "node examples/advanced-config/index.js"
  },
  "keywords": [
    "typedoc",
    "vitepress",
    "documentation",
    "sync",
    "api-docs",
    "markdown",
    "cache",
    "parallel",
    "typescript",
    "docs-generation"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/mineclover/context-action/tree/main/packages/typedoc-vitepress-sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/mineclover/context-action.git",
    "directory": "packages/typedoc-vitepress-sync"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "peerDependencies": {
    "typedoc": "^0.28.20",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "15.0.0",
    "ora": "9.4.1"
  },
  "devDependencies": {
    "@swc/core": "1.15.46",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "tsdown": "0.22.13",
    "typescript": "6.0.3"
  },
  "gitHead": "d044f181a22b8f1fc5ad3362afd30d117fedebdd"
}
