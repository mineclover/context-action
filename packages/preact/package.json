{
  "name": "@context-action/preact",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Preact dispatch and read-only Signals adapters",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@context-action/core": "workspace:*"
  },
  "peerDependencies": {
    "preact": "^10.27.3",
    "@preact/signals": "^2.11.3"
  },
  "devDependencies": {
    "preact": "10.27.3",
    "@preact/signals": "2.11.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
