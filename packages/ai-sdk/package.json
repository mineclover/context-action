{
  "name": "@context-action/ai-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "AI SDK v7 adapter for Context-Action canonical tool managers",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "lint": "pnpm --workspace-root exec biome lint packages/ai-sdk/src",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "tool-calling",
    "context-action"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/ai-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "dependencies": {
    "@context-action/tool-protocol": "^0.8.8"
  },
  "devDependencies": {
    "@context-action/tool-protocol": "workspace:*",
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "ai": "7.0.34",
    "jest": "30.4.2",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.13",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
