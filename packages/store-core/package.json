{
  "name": "@context-action/store-core",
  "version": "0.1.3",
  "type": "module",
  "description": "Framework-neutral store and timeline contracts for Context-Action",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "lint": "pnpm --workspace-root exec biome lint packages/store-core/src",
    "clean": "rimraf dist"
  },
  "keywords": [
    "state-management",
    "store",
    "timeline",
    "adapter"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/store-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "rimraf": "^6.1.3",
    "tsdown": "0.23.0",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
