{
  "name": "@context-action/mutative",
  "version": "0.8.6",
  "type": "module",
  "description": "Mutative-based immutability and time-travel utilities for @context-action",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:prod": "NODE_ENV=production tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "mutative",
    "immer",
    "immutable",
    "undo",
    "redo",
    "time-travel",
    "state-management"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/mutative"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mutative": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.15.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "mutative": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "gitHead": "a8ed013a4a6b2d08792f00ec30bdbc0f886b7c71"
}
