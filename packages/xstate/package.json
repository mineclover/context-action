{
  "name": "@context-action/xstate",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "XState v5/v6 and Effect v4 / @xstate/effect adapters for Context-Action pipelines, stores, and transaction scopes",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "lint": "pnpm --workspace-root exec biome lint packages/xstate/src",
    "clean": "rimraf dist"
  },
  "keywords": [
    "context-action",
    "xstate",
    "statechart",
    "effect",
    "state-management",
    "action-pipeline",
    "standard-schema"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/xstate"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@context-action/core": "^1.3.1",
    "@context-action/store-core": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "rimraf": "^6.1.4",
    "tsdown": "0.23.7",
    "tslib": "^2.9.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
