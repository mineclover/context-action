{
  "name": "@context-action/style-testing",
  "version": "0.1.0",
  "description": "Automated style testing tool for Context-Action framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "style-test": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "playwright": "^1.58.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "tsdown": "^0.15.2"
  },
  "keywords": [
    "style-testing",
    "css-testing",
    "tailwind-testing",
    "playwright"
  ]
}
