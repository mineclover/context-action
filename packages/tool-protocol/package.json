{
  "name": "@context-action/tool-protocol",
  "version": "1.0.0-rc.0",
  "type": "module",
  "description": "Framework-neutral action schemas and tool protocol contracts for Context-Action",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --runInBand --logHeapUsage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "lint": "pnpm --workspace-root exec biome lint packages/tool-protocol/src",
    "lint:fix": "pnpm --workspace-root exec biome lint --write packages/tool-protocol/src",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "typescript",
    "javascript",
    "mcp",
    "tool-calling",
    "json-schema",
    "zod",
    "context-action"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/tool-protocol"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action/tree/main/packages/tool-protocol",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.13",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
