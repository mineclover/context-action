{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/sem-doc-context-scope.v3.json",
  "title": "sem-doc operational ContextScope v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "context", "anchors", "nodes", "edges", "groups", "status"],
  "properties": {
    "schemaVersion": { "const": "sem-doc-context-scope.v3" },
    "source": { "$ref": "#/$defs/source" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/contextKind" },
        "label": { "$ref": "#/$defs/text" }
      }
    },
    "anchors": {
      "type": "array",
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "symbol"],
        "properties": {
          "role": { "enum": ["root", "endpoint", "trigger", "command", "definition"] },
          "symbol": { "$ref": "#/$defs/symbolRef" }
        }
      }
    },
    "nodes": { "type": "array", "maxItems": 65536, "uniqueItems": true, "items": { "$ref": "#/$defs/symbolRef" } },
    "edges": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind", "evidence"],
        "properties": {
          "from": { "$ref": "#/$defs/text" },
          "to": { "$ref": "#/$defs/text" },
          "kind": { "const": "depends-on" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "relation"],
            "properties": {
              "provider": { "const": "sem" },
              "relation": { "enum": ["dependency", "dependent"] }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "memberNodeKeys"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "kind": { "enum": ["context", "project"] },
          "label": { "$ref": "#/$defs/text" },
          "memberNodeKeys": { "type": "array", "maxItems": 65536, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "documentEvidence": {
      "type": "array",
      "maxItems": 16384,
      "items": { "$ref": "#/$defs/documentEvidence" }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "appliedLimits"],
      "properties": {
        "kind": { "enum": ["complete", "incomplete"] },
        "appliedLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxNodes", "maxEdges"],
          "properties": {
            "maxNodes": { "type": "integer", "minimum": 1 },
            "maxEdges": { "type": "integer", "minimum": 1 }
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["nodes", "edges", "evidence-unavailable", "disconnected-nodes"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "complete" } } },
          "then": { "not": { "required": ["reasons"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "incomplete" } } },
          "then": { "required": ["reasons"] }
        }
      ]
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextKind": { "enum": ["screen", "api", "transaction", "workflow", "document"] },
    "symbolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "filePath", "entityId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/text" },
        "filePath": { "$ref": "#/$defs/text" },
        "entityId": { "$ref": "#/$defs/text" }
      }
    },
    "documentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "target", "missingReferences"],
      "properties": {
        "root": { "$ref": "#/$defs/text" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "definitions", "backlinks", "candidates"],
          "properties": {
            "status": { "enum": ["resolved", "unresolved"] },
            "symbol": { "$ref": "#/$defs/text" },
            "definitions": { "type": "integer", "minimum": 0 },
            "backlinks": { "type": "integer", "minimum": 0 },
            "candidates": { "type": "integer", "minimum": 0 }
          }
        },
        "missingReferences": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workContext", "repositoryRoot", "revision", "engine", "workContextDigest", "projectId", "request"],
      "properties": {
        "workContext": { "const": "sem-doc-work-context.v5" },
        "repositoryRoot": { "$ref": "#/$defs/text" },
        "workContextDigest": { "$ref": "#/$defs/sha256" },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryRoot", "gitHead", "workingTreeDigest"],
          "properties": {
            "repositoryRoot": { "$ref": "#/$defs/text" },
            "gitHead": { "$ref": "#/$defs/text" },
            "workingTreeDigest": { "$ref": "#/$defs/text" }
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": { "name": { "const": "sem" }, "version": { "$ref": "#/$defs/text" } }
        },
        "projectId": { "$ref": "#/$defs/text" },
        "manifest": { "$ref": "#/$defs/manifest" },
        "workContexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/workContextSource" }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "depth", "budget", "impactArgs", "contextArgs", "execution"],
          "properties": {
            "entity": { "$ref": "#/$defs/text" },
            "file": { "$ref": "#/$defs/text" },
            "depth": { "type": "integer", "enum": [1, 2] },
            "budget": { "type": "integer", "minimum": 1 },
            "impactArgs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/text" } },
            "contextArgs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/text" } },
            "execution": { "$ref": "#/$defs/executionProvenance" }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "anchors"],
      "properties": {
        "schemaVersion": { "const": "sem-doc-context-manifest.v1" },
        "id": { "$ref": "#/$defs/text" },
        "kind": { "$ref": "#/$defs/contextKind" },
        "label": { "$ref": "#/$defs/text" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "entity"],
            "properties": {
              "role": { "enum": ["root", "endpoint", "trigger", "command", "definition"] },
              "entity": { "$ref": "#/$defs/text" },
              "file": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "workContextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workContext", "repositoryRoot", "revision", "engine", "workContextDigest", "request"],
      "properties": {
        "workContext": { "const": "sem-doc-work-context.v5" },
        "repositoryRoot": { "$ref": "#/$defs/text" },
        "workContextDigest": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/revision" },
        "engine": { "$ref": "#/$defs/engine" },
        "request": { "$ref": "#/$defs/request" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRoot", "gitHead", "workingTreeDigest"],
      "properties": {
        "repositoryRoot": { "$ref": "#/$defs/text" },
        "gitHead": { "$ref": "#/$defs/text" },
        "workingTreeDigest": { "$ref": "#/$defs/text" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "sem" }, "version": { "$ref": "#/$defs/text" } }
    },
    "executionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "ownerId", "state", "timeoutMs", "maxOutputBytes", "usedOutputBytes", "elapsedMs"],
      "properties": {
        "phase": { "enum": ["work-context", "context-scope-history"] },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "state": { "enum": ["completed", "failed", "cancelled", "unknown"] },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "usedOutputBytes": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "integer", "minimum": 0 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "depth", "budget", "impactArgs", "contextArgs", "execution"],
      "properties": {
        "entity": { "$ref": "#/$defs/text" },
        "file": { "$ref": "#/$defs/text" },
        "depth": { "type": "integer", "enum": [1, 2] },
        "budget": { "type": "integer", "minimum": 1 },
        "impactArgs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/text" } },
        "contextArgs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/text" } },
        "execution": { "$ref": "#/$defs/executionProvenance" }
      }
    }
  }
}
