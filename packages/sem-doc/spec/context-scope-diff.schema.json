{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/sem-doc-context-scope-diff.v1.json",
  "title": "sem-doc ContextScope diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "context", "before", "after", "addedNodes", "removedNodes", "addedEdges", "removedEdges", "addedGroups", "removedGroups", "changedGroups", "summary"],
  "properties": {
    "schemaVersion": { "const": "sem-doc-context-scope-diff.v1" },
    "context": { "type": "object" },
    "before": { "$ref": "#/$defs/revision" },
    "after": { "$ref": "#/$defs/revision" },
    "addedNodes": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
    "removedNodes": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
    "addedEdges": { "type": "array", "items": { "type": "object" } },
    "removedEdges": { "type": "array", "items": { "type": "object" } },
    "addedGroups": { "type": "array", "items": { "type": "object" } },
    "removedGroups": { "type": "array", "items": { "type": "object" } },
    "changedGroups": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "filePath", "entityId"],
      "properties": { "projectId": { "$ref": "#/$defs/text" }, "filePath": { "$ref": "#/$defs/text" }, "entityId": { "$ref": "#/$defs/text" } }
    },
    "revision": {
      "type": "object",
      "required": ["repositoryRoot", "revision", "workContextDigest"],
      "properties": { "repositoryRoot": { "$ref": "#/$defs/text" }, "revision": { "type": "object" }, "workContextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
