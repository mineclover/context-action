{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/sem-doc-context-scope-branch-compare.v1.json",
  "title": "sem-doc ContextScope branch comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "context", "base", "left", "right", "intersection", "summary"],
  "properties": {
    "schemaVersion": { "const": "sem-doc-context-scope-branch-compare.v1" },
    "context": { "type": "object" },
    "base": { "type": "object", "required": ["commit", "revision"], "properties": { "commit": { "type": "string" }, "revision": { "type": "object" } } },
    "left": { "$ref": "#/$defs/changes" },
    "right": { "$ref": "#/$defs/changes" },
    "intersection": { "$ref": "#/$defs/changes" },
    "summary": { "type": "object" }
  },
  "$defs": {
    "changes": {
      "type": "object",
      "required": ["nodes", "edges", "groups"],
      "properties": {
        "commits": { "type": "integer", "minimum": 0 },
        "head": { "type": "string" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "groups": { "type": "array" }
      }
    }
  }
}
