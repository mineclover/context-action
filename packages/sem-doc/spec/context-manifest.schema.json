{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/sem-doc-context-manifest.v1.json",
  "title": "sem-doc context manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "anchors"],
  "properties": {
    "schemaVersion": { "const": "sem-doc-context-manifest.v1" },
    "id": { "$ref": "#/$defs/text" },
    "kind": { "enum": ["screen", "api", "transaction", "workflow", "document"] },
    "label": { "$ref": "#/$defs/text" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "entity"],
        "properties": {
          "role": { "enum": ["root", "endpoint", "trigger", "command", "definition"] },
          "entity": { "$ref": "#/$defs/text" },
          "file": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" }
  }
}
