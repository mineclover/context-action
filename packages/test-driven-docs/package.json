{
  "name": "@context-action/test-driven-docs",
  "version": "0.1.0",
  "description": "Stable and repeatable test metadata extraction library that outputs structured JSON data from test files",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "test-metadata-extractor": "dist/cli/extract.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/extract.d.ts",
      "default": "./dist/cli/extract.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "test-metadata",
    "data-extraction",
    "ast-parsing",
    "json-output",
    "typescript",
    "testing",
    "metadata-extraction",
    "developer-tools"
  ],
  "author": "Context-Action Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mineclover/context-action.git",
    "directory": "packages/test-driven-docs"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action/tree/main/packages/test-driven-docs#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "tsdown": "^0.2.13"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}