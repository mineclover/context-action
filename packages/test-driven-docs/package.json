{
  "name": "@context-action/test-driven-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Complete test-driven documentation system with annotation-based extraction, enhanced markdown generation, and consistency validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "test-driven-docs": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./extractors": {
      "types": "./dist/extractors/index.d.ts",
      "import": "./dist/extractors/index.js",
      "default": "./dist/extractors/index.js"
    },
    "./generators": {
      "types": "./dist/generators/index.d.ts",
      "import": "./dist/generators/index.js",
      "default": "./dist/generators/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.js",
      "default": "./dist/validators/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    }
  },
  "files": [
    "dist/**",
    "examples/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "jest",
    "posttest": "npm run test:exports",
    "test:exports": "node scripts/verify-exports.mjs && tsc --ignoreConfig --noEmit --strict --skipLibCheck false --module NodeNext --moduleResolution NodeNext --target ES2022 --types node test-d/exports.ts",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "test-driven-documentation",
    "annotation-extraction",
    "enhanced-markdown",
    "documentation-generation",
    "consistency-validation",
    "test-metadata",
    "ast-parsing",
    "typescript",
    "testing",
    "developer-tools",
    "single-source-of-truth",
    "automated-docs"
  ],
  "author": "Context-Action Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mineclover/context-action.git",
    "directory": "packages/test-driven-docs"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action/tree/main/packages/test-driven-docs#readme",
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "15.0.0",
    "ora": "9.4.1"
  },
  "devDependencies": {
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "tsdown": "0.22.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
