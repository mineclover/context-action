{
  "name": "@context-action/lit-ui",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Lit Web Component primitives, FACE support, W3C context protocol, React bridge, and SSR/hydration entries",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react-bridge": {
      "import": {
        "types": "./dist/react-bridge.d.ts",
        "default": "./dist/react-bridge.js"
      },
      "require": {
        "types": "./dist/react-bridge.d.cts",
        "default": "./dist/react-bridge.cjs"
      }
    },
    "./ssr": {
      "import": {
        "types": "./dist/ssr.d.ts",
        "default": "./dist/ssr.js"
      },
      "require": {
        "types": "./dist/ssr.d.cts",
        "default": "./dist/ssr.cjs"
      }
    },
    "./hydrate": {
      "import": {
        "types": "./dist/hydrate.d.ts",
        "default": "./dist/hydrate.js"
      },
      "require": {
        "types": "./dist/hydrate.d.cts",
        "default": "./dist/hydrate.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:edge": "node --test test/edge-runtime.test.mjs",
    "test:browser": "node test/browser-hydration.test.mjs"
  },
  "dependencies": {
    "@context-action/core": "workspace:*",
    "@context-action/lit": "^0.1.3"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@lit/context": "^1.1.0",
    "lit": "^3.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    },
    "@lit-labs/ssr-client": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit/context": "1.1.6",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.1.3",
    "lit": "3.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/lit-ui"
  }
}
