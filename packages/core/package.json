{
  "name": "@context-action/core",
  "version": "0.9.2",
  "type": "module",
  "description": "Type-safe action pipeline management library for JavaScript/TypeScript",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --runInBand --logHeapUsage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "pnpm --workspace-root exec biome lint packages/core/src",
    "lint:fix": "pnpm --workspace-root exec biome lint --write packages/core/src",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "clean": "rimraf dist coverage",
    "security:audit": "pnpm --workspace-root security:audit",
    "security:outdated": "pnpm outdated",
    "security:check": "pnpm security:audit && pnpm security:outdated",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "typescript",
    "javascript",
    "action",
    "pipeline",
    "state-management",
    "event-system"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@swc/core": "1.15.46",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "@context-action/tool-protocol": "workspace:*",
    "jest": "30.4.2",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.13",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "browser": {
    "node:module": false,
    "node:path": false,
    "node:fs": false,
    "node:url": false,
    "node:crypto": false,
    "node:buffer": false
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "gitHead": "d044f181a22b8f1fc5ad3362afd30d117fedebdd"
}
