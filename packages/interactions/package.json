{
  "name": "@context-action/interactions",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-neutral headless UI and ARIA interaction primitives (roving focus, typeahead, pointer gestures, LIFO dismiss layers) for Context-Action",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsdown",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "lint": "pnpm --workspace-root exec biome lint packages/interactions/src",
    "clean": "rimraf dist"
  },
  "keywords": [
    "context-action",
    "headless-ui",
    "aria",
    "roving-focus",
    "pointer-gestures",
    "dismiss-layer",
    "interactions"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/interactions"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@context-action/core": "workspace:*",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "rimraf": "^6.1.4",
    "tsdown": "0.23.7",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
