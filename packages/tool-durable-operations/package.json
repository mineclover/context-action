{
  "name": "@context-action/tool-durable-operations",
  "version": "0.1.1",
  "type": "module",
  "description": "Durable idempotency and external side-effect adapters for Context-Action tool mutations",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tool-durable-write-evidence": "scripts/write-verification-evidence.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "spec",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --runInBand --logHeapUsage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify:redis": "pnpm run build && node scripts/verify-redis.mjs",
    "verify:postgres": "pnpm run build && node scripts/verify-postgres.mjs",
    "verify:http": "pnpm run build && node scripts/verify-http-side-effect.mjs",
    "verify:queue": "pnpm run build && node scripts/verify-queue-side-effect.mjs",
    "verify:env": "node scripts/verify-durable-operation-env.mjs",
    "write:evidence": "node scripts/write-verification-evidence.mjs",
    "type-check:src": "tsc --noEmit",
    "test:type-check": "tsc -p __tests__/tsconfig.json --pretty false",
    "type-check": "pnpm run type-check:src && pnpm run test:type-check",
    "lint": "pnpm --workspace-root exec biome lint packages/tool-durable-operations/src",
    "lint:fix": "pnpm --workspace-root exec biome lint --write packages/tool-durable-operations/src",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "typescript",
    "tool-calling",
    "idempotency",
    "durable-operations",
    "context-action"
  ],
  "author": "mineclover",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/context-action.git",
    "directory": "packages/tool-durable-operations"
  },
  "bugs": {
    "url": "https://github.com/mineclover/context-action/issues"
  },
  "homepage": "https://github.com/mineclover/context-action/tree/main/packages/tool-durable-operations",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "pg": "^8.22.0",
    "redis": "^5.12.1",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.13",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
