{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "packages/core/src/**/*.ts",
      "packages/core/examples/element-hosts/**/*.ts",
      "packages/store-core/src/**/*.ts",
      "packages/tool-protocol/src/**/*.ts",
      "packages/webmcp/src/**/*.ts",
      "packages/tool-durable-operations/src/**/*.ts",
      "packages/ai-sdk/src/**/*.ts",
      "packages/react/src/**/*.ts",
      "packages/react/src/**/*.tsx",
      "packages/mutative-core/src/**/*.ts",
      "packages/mutative/src/**/*.ts",
      "packages/mutative/examples/travels-v3/**/*.ts",
      "packages/xstate/src/**/*.ts",
      "scripts/**/*.cjs",
      "scripts/**/*.mjs",
      "packages/preact/src/**/*.ts",
      "packages/preact/src/**/*.tsx",
      "packages/preact-ui/src/**/*.ts",
      "packages/preact-ui/examples/**/*.ts",
      "packages/preact-ui/examples/**/*.tsx",
      "packages/lit/src/**/*.ts",
      "packages/lit-ui/src/**/*.ts",
      "packages/lit-ui/examples/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [
        "packages/preact-ui/src/react-bridge.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/lit/src/**/*.ts",
        "packages/lit-ui/src/**/*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/preact-ui/examples/projected-order/business/order-types.ts",
        "packages/preact-ui/examples/shared/counter-model.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/mutative-core/src/**/*.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "off",
            "noCommaOperator": "off",
            "noUselessTypeConstraint": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noSwitchDeclarations": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useConst": "off"
          },
          "suspicious": {
            "noConstEnum": "off",
            "noConfusingVoidType": "off",
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off",
            "noPrototypeBuiltins": "off",
            "noSelfCompare": "off",
            "noShadowRestrictedNames": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/coordinated-stable-release.test.mjs",
        "scripts/verify-v1-release-workflows.mjs",
        "scripts/verify-v1-release-workflows.test.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/react/src/actions/ActionContext.tsx",
        "packages/react/src/refs/createRefContext.ts",
        "packages/react/src/stores/patterns/declarative-store-pattern-v2.tsx",
        "packages/react/src/stores/patterns/time-travel-store-pattern.tsx",
        "packages/react/src/tools/ToolContext.tsx",
        "packages/preact-ui/examples/modular-signals-wc/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noUselessFragments": "off"
      },
      "correctness": {
        "noEmptyCharacterClassInRegex": "off",
        "noUnusedFunctionParameters": "off",
        "useExhaustiveDependencies": "warn",
        "useUniqueElementIds": "off"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noReExportAll": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useFilenamingConvention": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "warn",
        "noTsIgnore": "warn",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
