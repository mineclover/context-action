{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": [
      "packages/core/src/**/*.ts",
      "packages/tool-protocol/src/**/*.ts",
      "packages/tool-durable-operations/src/**/*.ts",
      "packages/react/src/**/*.ts",
      "packages/react/src/**/*.tsx",
      "packages/mutative-core/src/**/*.ts",
      "packages/mutative/src/**/*.ts",
      "packages/llms-generator/src/**/*.ts",
      "packages/typedoc-vitepress-sync/src/**/*.ts",
      "scripts/security-audit.mjs",
      "scripts/verify-private-tools.mjs"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["packages/mutative-core/src/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "off",
            "noCommaOperator": "off",
            "noUselessTypeConstraint": "off"
          },
          "correctness": {
            "noSwitchDeclarations": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useConst": "off"
          },
          "suspicious": {
            "noConstEnum": "off",
            "noConfusingVoidType": "off",
            "noExplicitAny": "off",
            "noPrototypeBuiltins": "off",
            "noSelfCompare": "off",
            "noShadowRestrictedNames": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noUselessFragments": "off"
      },
      "correctness": {
        "noEmptyCharacterClassInRegex": "off",
        "noUnusedFunctionParameters": "off",
        "useExhaustiveDependencies": "warn",
        "useUniqueElementIds": "off"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noReExportAll": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useFilenamingConvention": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "warn",
        "noTsIgnore": "warn",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
