{
  "name": "context-action-monorepo",
  "version": "1.0.1",
  "type": "module",
  "private": true,
  "description": "Monorepo for context-action library and test environment",
  "scripts": {
    "build": "lerna run build",
    "build:core": "lerna run build --scope=@context-action/core",
    "build:react": "lerna run build --scope=@context-action/react",
    "build:llms-generator": "lerna run build --scope=@context-action/llms-generator",
    "dev": "cd example && pnpm dev",
    "example:build": "cd example && pnpm build",
    "example:build:fast": "cd example && pnpm build:fast",
    "test": "lerna run test",
    "test:core": "lerna run test --scope=@context-action/core",
    "lint": "lerna run lint",
    "type-check": "lerna run type-check",
    "clean": "lerna run clean",
    "version": "lerna version",
    "version:patch": "lerna version patch",
    "version:minor": "lerna version minor",
    "version:major": "lerna version major",
    "prerelease": "lerna run build && lerna run lint && lerna run type-check",
    "release": "lerna publish from-package",
    "release:patch": "lerna version patch && pnpm release",
    "changed": "lerna changed",
    "diff": "lerna diff",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:api": "typedoc",
    "docs:sync": "npx @context-action/typedoc-vitepress-sync sync --config ./typedoc-vitepress-sync.config.js",
    "docs:full": "pnpm docs:api && pnpm docs:sync && pnpm docs:build",
    "llms:priority-stats": "node packages/llms-generator/dist/cli/index.js priority-stats",
    "llms:priority-health": "node packages/llms-generator/dist/cli/index.js priority-health",
    "llms:priority-suggest": "node packages/llms-generator/dist/cli/index.js priority-suggest",
    "llms:priority-auto": "node packages/llms-generator/dist/cli/index.js priority-auto",
    "llms:sync-docs": "node packages/llms-generator/dist/cli/index.js sync-docs",
    "llms:sync-docs:ko": "node packages/llms-generator/dist/cli/index.js sync-docs --only-korean",
    "llms:sync-docs:en": "node packages/llms-generator/dist/cli/index.js sync-docs --only-english",
    "llms:sync-docs:dry": "node packages/llms-generator/dist/cli/index.js sync-docs --dry-run",
    "llms:generate-templates": "node packages/llms-generator/dist/cli/index.js generate-templates",
    "llms:init": "node packages/llms-generator/dist/cli/index.js init",
    "llms:work-next": "node packages/llms-generator/dist/cli/index.js work-next",
    "llms:detect-mismatches": "node packages/llms-generator/dist/cli/index.js detect-mismatches",
    "llms:code-mode": "node packages/llms-generator/dist/cli/index.js code-mode",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:all": "lerna run security:audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "^24.3.0",
    "@types/react": "18.3.23",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ansis": "4.1.0",
    "autoprefixer": "10.4.21",
    "comment-parser": "^1.4.1",
    "eslint": "^9.34.0",
    "husky": "9.1.7",
    "lerna": "^8.2.3",
    "mermaid": "^11.10.1",
    "postcss": "8.5.6",
    "shiki": "^3.11.0",
    "tailwindcss": "4.1.12",
    "tsdown": "^0.14.2",
    "typedoc": "^0.28.11",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "@types/react": "18.3.23"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  },
  "author": "mineclover",
  "license": "MIT"
}
