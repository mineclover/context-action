{
  "name": "context-action-monorepo",
  "version": "1.0.1",
  "type": "module",
  "private": true,
  "description": "Monorepo for context-action library and test environment",
  "scripts": {
    "build": "lerna run build",
    "build:core": "lerna run build --scope=@context-action/core",
    "build:react": "lerna run build --scope=@context-action/react",
    "build:llms-generator": "lerna run build --scope=@context-action/llms-generator",
    "build:mutative": "lerna run build --scope=@context-action/mutative",
    "build:live-code-editor": "pnpm --filter @context-action/live-code-editor build",
    "check:live-code-editor": "pnpm --filter @context-action/live-code-editor check",
    "verify:package-exports": "node scripts/verify-package-exports.mjs",
    "verify:package-tarballs": "node scripts/verify-package-tarballs.mjs",
    "verify:all": "pnpm build && pnpm verify:package-exports && pnpm verify:package-tarballs && pnpm lint && pnpm convention:check && pnpm type-check && pnpm test && pnpm --filter example check && pnpm --filter example build && pnpm docs:build && pnpm verify:private-tools",
    "dev": "cd example && pnpm dev",
    "example:build": "cd example && pnpm build",
    "example:build:fast": "cd example && pnpm build:fast",
    "web-coding:dev": "pnpm --filter @context-action/web-coding-demo dev",
    "web-coding:build": "pnpm --filter @context-action/web-coding-demo build",
    "web-coding:verify": "pnpm --filter @context-action/web-coding-demo verify",
    "test": "lerna run test",
    "test:canonical-example": "pnpm --dir packages/react test:canonical-example",
    "test:core": "lerna run test --scope=@context-action/core",
    "test:live-code-editor": "pnpm --filter @context-action/live-code-editor test",
    "lint": "biome lint packages/core/src packages/react/src packages/mutative/src packages/llms-generator/src packages/typedoc-vitepress-sync/src",
    "convention:check": "node scripts/check-context-layered-conventions.mjs",
    "type-check": "lerna run type-check",
    "type-check:live-code-editor": "pnpm --filter @context-action/live-code-editor type-check",
    "verify:private-tools": "node scripts/verify-private-tools.mjs",
    "clean": "lerna run clean",
    "version:interactive": "lerna version",
    "version:patch": "lerna version patch",
    "version:minor": "lerna version minor",
    "version:major": "lerna version major",
    "prerelease": "lerna run build && pnpm verify:package-exports && pnpm verify:package-tarballs && pnpm lint && lerna run type-check",
    "release": "lerna publish from-package",
    "release:patch": "lerna version patch && pnpm release",
    "changed": "lerna changed",
    "diff": "lerna diff",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:api": "typedoc --options ./typedoc.json",
    "docs:sync": "npx @context-action/typedoc-vitepress-sync sync --config ./typedoc-vitepress-sync.config.js",
    "docs:api-generate": "node scripts/generate-api-docs.js",
    "docs:full": "pnpm docs:api && pnpm docs:sync && pnpm docs:api-generate && pnpm docs:build",
    "llms:priority-stats": "node packages/llms-generator/dist/cli/index.js priority-stats",
    "llms:priority-health": "node packages/llms-generator/dist/cli/index.js priority-health",
    "llms:priority-suggest": "node packages/llms-generator/dist/cli/index.js priority-suggest",
    "llms:priority-auto": "node packages/llms-generator/dist/cli/index.js priority-auto",
    "llms:sync-docs": "node packages/llms-generator/dist/cli/index.js sync-docs",
    "llms:sync-docs:ko": "node packages/llms-generator/dist/cli/index.js sync-docs --only-korean",
    "llms:sync-docs:en": "node packages/llms-generator/dist/cli/index.js sync-docs --only-english",
    "llms:sync-docs:dry": "node packages/llms-generator/dist/cli/index.js sync-docs --dry-run",
    "llms:generate-templates": "node packages/llms-generator/dist/cli/index.js generate-templates",
    "llms:generate:en": "node packages/llms-generator/dist/cli/index.js generate-templates --language en",
    "llms:generate:ko": "node packages/llms-generator/dist/cli/index.js generate-templates --language ko",
    "llms:docs": "node packages/llms-generator/dist/cli/index.js generate-templates",
    "llms:docs:en": "node packages/llms-generator/dist/cli/index.js generate-templates --language en",
    "llms:docs:ko": "node packages/llms-generator/dist/cli/index.js generate-templates --language ko",
    "llms:init": "node packages/llms-generator/dist/cli/index.js init",
    "llms:work-next": "node packages/llms-generator/dist/cli/index.js work-next",
    "llms:work-top10": "node packages/llms-generator/dist/cli/index.js work-next --limit 10",
    "llms:work-top20": "node packages/llms-generator/dist/cli/index.js work-next --limit 20",
    "llms:priority-tasks": "node packages/llms-generator/dist/cli/index.js priority-tasks",
    "llms:priority-tasks:fix": "node packages/llms-generator/dist/cli/index.js priority-tasks --fix",
    "llms:detect-mismatches": "node packages/llms-generator/dist/cli/index.js detect-mismatches",
    "llms:code-mode": "node packages/llms-generator/dist/cli/index.js code-mode --force",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:all": "lerna run security:audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ansis": "4.3.1",
    "autoprefixer": "10.5.2",
    "comment-parser": "1.4.7",
    "husky": "9.1.7",
    "lerna": "^9.0.7",
    "mermaid": "11.16.0",
    "postcss": "8.5.17",
    "shiki": "4.3.1",
    "tailwindcss": "4.3.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vue": "3.5.39"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.30.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "0.25.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "@types/react": "19.2.17",
      "preact@>=10.27.0 <10.27.3": "10.27.3",
      "js-yaml@<4.0.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.2.0": "4.2.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": "13.2.1",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "handlebars@>=4.0.0 <4.7.9": "4.7.9",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "lodash-es@<=4.17.23": "4.18.0",
      "defu@<=6.1.4": "6.1.5",
      "vitepress>vite": "6.4.3",
      "vitest>vite": "8.0.16",
      "follow-redirects@<=1.15.11": "1.16.0",
      "dompurify@<3.4.11": "3.4.11",
      "axios@>=1.0.0 <1.16.0": "1.16.0",
      "fast-uri@<=3.1.1": "3.1.2",
      "ip-address@<=10.1.0": "10.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "uuid@<11.1.1": "11.1.1",
      "react-router@>=7.0.0 <8.0.0": "7.18.1",
      "mermaid@>=11.0.0-alpha.1 <11.16.0": "11.16.0",
      "tmp@<0.2.7": "0.2.7",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "tar@<=7.5.15": "7.5.16",
      "@babel/core@<=7.29.0": "7.29.7",
      "markdown-it@<=14.1.1": "14.2.0",
      "@sigstore/core@<=3.2.0": "3.2.1",
      "linkify-it@<=5.0.0": "5.0.1",
      "sigstore@<=4.1.0": "4.1.1",
      "@sigstore/verify@3.1.0": "3.1.1"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  },
  "author": "mineclover",
  "license": "Apache-2.0"
}
