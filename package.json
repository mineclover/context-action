{
  "name": "context-action-monorepo",
  "version": "1.0.1",
  "type": "module",
  "private": true,
  "description": "Monorepo for context-action library and test environment",
  "scripts": {
    "build": "lerna run build",
    "build:core": "lerna run build --scope=@context-action/core",
    "build:react": "lerna run build --scope=@context-action/react",
    "build:llms-generator": "lerna run build --scope=@context-action/llms-generator",
    "build:mutative": "lerna run build --scope=@context-action/mutative",
    "dev": "cd example && pnpm dev",
    "example:build": "cd example && pnpm build",
    "example:build:fast": "cd example && pnpm build:fast",
    "test": "lerna run test",
    "test:canonical-example": "pnpm --dir packages/react test:canonical-example",
    "test:core": "lerna run test --scope=@context-action/core",
    "lint": "lerna run lint",
    "type-check": "lerna run type-check",
    "clean": "lerna run clean",
    "version:interactive": "lerna version",
    "version:patch": "lerna version patch",
    "version:minor": "lerna version minor",
    "version:major": "lerna version major",
    "prerelease": "lerna run build && lerna run lint && lerna run type-check",
    "release": "lerna publish from-package",
    "release:patch": "lerna version patch && pnpm release",
    "changed": "lerna changed",
    "diff": "lerna diff",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:api": "typedoc --options ./typedoc.json",
    "docs:sync": "npx @context-action/typedoc-vitepress-sync sync --config ./typedoc-vitepress-sync.config.js",
    "docs:api-generate": "node scripts/generate-api-docs.js",
    "docs:extract-from-tests": "node packages/test-driven-docs/dist/cli/index.js generate --enhanced --packages react",
    "docs:validate-docs": "node packages/test-driven-docs/dist/cli/index.js validate --consistency",
    "docs:enhanced": "node packages/test-driven-docs/dist/cli/index.js generate --enhanced --github-repo https://github.com/mineclover/context-action",
    "docs:enhanced-with-validation": "node packages/test-driven-docs/dist/cli/index.js generate --with-validation --github-repo https://github.com/mineclover/context-action",
    "docs:full": "pnpm docs:api && pnpm docs:sync && pnpm docs:enhanced --packages react && pnpm docs:api-generate && pnpm docs:build",
    "llms:priority-stats": "node packages/llms-generator/dist/cli/index.js priority-stats",
    "llms:priority-health": "node packages/llms-generator/dist/cli/index.js priority-health",
    "llms:priority-suggest": "node packages/llms-generator/dist/cli/index.js priority-suggest",
    "llms:priority-auto": "node packages/llms-generator/dist/cli/index.js priority-auto",
    "llms:sync-docs": "node packages/llms-generator/dist/cli/index.js sync-docs",
    "llms:sync-docs:ko": "node packages/llms-generator/dist/cli/index.js sync-docs --only-korean",
    "llms:sync-docs:en": "node packages/llms-generator/dist/cli/index.js sync-docs --only-english",
    "llms:sync-docs:dry": "node packages/llms-generator/dist/cli/index.js sync-docs --dry-run",
    "llms:generate-templates": "node packages/llms-generator/dist/cli/index.js generate-templates",
    "llms:init": "node packages/llms-generator/dist/cli/index.js init",
    "llms:work-next": "node packages/llms-generator/dist/cli/index.js work-next",
    "llms:detect-mismatches": "node packages/llms-generator/dist/cli/index.js detect-mismatches",
    "llms:code-mode": "node packages/llms-generator/dist/cli/index.js code-mode --force",
    "style-test": "node packages/style-testing/dist/cli/index.js test --url http://localhost:4000 --source ./example/src",
    "style-test:snapshot": "node packages/style-testing/dist/cli/index.js snapshot --url http://localhost:4000",
    "style-test:verbose": "node packages/style-testing/dist/cli/index.js test --url http://localhost:4000 --source ./example/src --verbose",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:all": "lerna run security:audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "ansis": "4.2.0",
    "autoprefixer": "10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "comment-parser": "^1.4.5",
    "eslint": "^9.35.0",
    "husky": "9.1.7",
    "lerna": "^9.0.7",
    "mermaid": "^11.13.0",
    "postcss": "8.5.8",
    "rolldown": "1.0.0-beta.58",
    "rolldown-plugin-dts": "0.16.11",
    "shiki": "^4.0.2",
    "tailwindcss": "4.2.2",
    "tsdown": "^0.15.2",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vue": "3.5.31"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "rolldown": "1.0.0-beta.58",
      "esbuild@<=0.24.2": ">=0.25.0",
      "@types/react": "18.3.23"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  },
  "author": "mineclover",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0"
  }
}
