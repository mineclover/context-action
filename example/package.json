{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Example application for @context-action/core library",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:fast": "vite build",
    "build:strict": "tsc && vite build",
    "preview": "vite preview",
    "test": "echo 'No tests for example app'",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:write": "biome format --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "analyze": "vite-bundle-analyzer",
    "bundle-report": "vite build --mode analyze"
  },
  "dependencies": {
    "@context-action/core": "workspace:*",
    "@context-action/react": "workspace:*",
    "ai": "6.0.140",
    "dotenv": "^17.3.1",
    "gsap": "3.14.2",
    "immer": "11.1.4",
    "jotai": "^2.19.0",
    "openai": "6.33.0",
    "react": "^19.2.4",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "^19.2.4",
    "react-router": "7.13.2",
    "react-router-dom": "^7.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "postcss": "8.5.8",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-bundle-analyzer": "1.3.6"
  }
}
