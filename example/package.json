{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Example application for @context-action/core library",
  "scripts": {
    "prepare:preact-ui": "pnpm --filter @context-action/preact build && pnpm --filter @context-action/preact-ui build && pnpm --filter @context-action/lit build && pnpm --filter @context-action/lit-ui build",
    "predev": "pnpm run prepare:preact-ui && pnpm --filter @context-action/openrouter-browser-storage build",
    "prebuild": "pnpm run prepare:preact-ui && pnpm --filter @context-action/openrouter-browser-storage check && pnpm --filter @context-action/openrouter-browser-storage build",
    "prebuild:fast": "pnpm run prepare:preact-ui && pnpm --filter @context-action/openrouter-browser-storage build",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:fast": "vite build",
    "build:strict": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "pnpm run prepare:preact-ui",
    "test": "vitest run",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:write": "biome format --write src",
    "check": "biome check src && pnpm run verify:catalog && pnpm run verify:approval && pnpm run verify:trace && pnpm run verify:usecase && pnpm run verify:conditional && pnpm run verify:mouse-action && pnpm run verify:mouse-pattern && pnpm run verify:mouse-enhanced",
    "check:fix": "biome check --write src",
    "pretype-check": "pnpm run prepare:preact-ui",
    "type-check": "tsc --noEmit",
    "verify:catalog": "node ../scripts/verify-mcp-function-calling-catalog.mjs",
    "preverify:approval": "pnpm --filter @context-action/core build",
    "verify:approval": "node ../scripts/verify-example-live-editor-approval.mjs",
    "verify:trace": "node ../scripts/verify-example-tool-call-trace.mjs",
    "verify:usecase": "node ../scripts/verify-live-usecase-conventions.mjs",
    "verify:conditional": "node ../scripts/verify-conditional-permission-conventions.mjs",
    "verify:mouse-action": "node ../scripts/verify-context-store-action-mouse-conventions.mjs",
    "verify:mouse-pattern": "node ../scripts/verify-context-store-pattern-conventions.mjs",
    "verify:mouse-enhanced": "node ../scripts/verify-enhanced-context-store-conventions.mjs",
    "verify:route-smoke": "node ../scripts/verify-example-route-smoke.mjs",
    "clean": "rimraf dist",
    "analyze": "vite-bundle-analyzer",
    "bundle-report": "vite build --mode analyze"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.60",
    "@context-action/ai-sdk": "workspace:*",
    "@context-action/core": "workspace:*",
    "@context-action/lit": "workspace:*",
    "@context-action/lit-ui": "workspace:*",
    "@context-action/live-code-editor": "workspace:*",
    "@context-action/openrouter-browser-storage": "workspace:*",
    "@context-action/preact": "workspace:*",
    "@context-action/preact-ui": "workspace:*",
    "@context-action/react": "workspace:*",
    "@context-action/tool-durable-operations": "workspace:*",
    "@context-action/tool-protocol": "workspace:*",
    "@preact/signals": "^2.11.3",
    "ai": "7.0.123",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "immer": "11.1.18",
    "lit": "3.3.3",
    "preact": "^10.27.3",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.4",
    "@internationalized/date": "3.12.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@biomejs/biome": "2.5.14",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "rolldown": "1.2.11",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-bundle-analyzer": "1.3.9",
    "vitest": "4.1.11",
    "jsdom": "26.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
