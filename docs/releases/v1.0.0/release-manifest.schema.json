{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-action.dev/schemas/v1-release-manifest.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "release",
    "commit",
    "packages",
    "stableSurfaces",
    "experimentalSurfaces",
    "requiredBeforeCertification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "context-action-v1-release-manifest.v3" },
    "status": {
      "enum": [
        "candidate-unapproved",
        "candidate-approved-for-publish",
        "published-pending-provenance",
        "published-unapproved",
        "audited",
        "approved-for-stable",
        "promoted"
      ]
    },
    "release": { "const": "context-action-v1.0.0" },
    "commit": { "type": ["string", "null"] },
    "prePublicationAudit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "rcCommit", "evidence", "evidenceSha256"],
      "properties": {
        "status": { "const": "accepted" },
        "rcCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "packages": { "type": "object", "additionalProperties": { "type": "string" } },
    "stableSurfaces": { "type": "array", "items": { "type": "string" } },
    "experimentalSurfaces": { "type": "array", "items": { "type": "string" } },
    "testedExternalDependencies": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/testedExternalDependency" }
    },
    "promotionTargets": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }
    },
    "requiredBeforeCertification": { "type": "array", "items": { "type": "string" } },
    "distTag": { "type": ["string", "null"] },
    "registryEvidence": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/registryPackage" }
    },
    "audit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "report", "reviewer", "reviewedCommit", "evidence", "reportSha256", "evidenceSha256"],
      "properties": {
        "status": { "enum": ["not-started", "accepted", "rejected"] },
        "report": { "type": ["string", "null"] },
        "reviewer": { "type": ["string", "null"] },
        "reviewedCommit": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "reportSha256": { "type": ["string", "null"] },
        "evidenceSha256": { "type": ["string", "null"] }
      }
    },
    "releaseApproval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "status",
        "owner",
        "reviewedCommit",
        "record",
        "recordSha256",
        "scopeSha256",
        "contractSha256",
        "legacyLedgerSha256"
      ],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewedCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "record": { "type": "string", "minLength": 1 },
        "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scopeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "legacyLedgerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "registryPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "integrity",
        "sha256",
        "tarball",
        "publishedAt",
        "distTags",
        "provenance",
        "externalConsumer"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "integrity": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tarball": { "type": "string", "format": "uri" },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "distTags": { "type": "object", "additionalProperties": { "type": "string" } },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceCommit"],
          "properties": {
            "status": { "enum": ["pending-verification", "verified", "failed"] },
            "sourceCommit": { "type": ["string", "null"] },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["verifier", "evidence"],
              "properties": {
                "verifier": { "const": "npm audit signatures --include-attestations" },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "externalConsumer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "enum": ["passed", "failed", "not-run"] } }
        }
      }
    },
    "testedExternalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "supportedRange", "testedVersion"],
      "properties": {
        "classification": { "const": "tested-external-dependency" },
        "supportedRange": { "type": "string", "minLength": 1 },
        "testedVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
