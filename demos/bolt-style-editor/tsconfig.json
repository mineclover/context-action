{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@context-action/react/tools": [
        "../../packages/react/src/tools/index.ts"
      ],
      "@context-action/core": ["../../packages/core/src/index.ts"],
      "@context-action/live-code-editor": [
        "../../packages/live-code-editor/src/index.ts"
      ],
      "@context-action/openrouter-browser-storage": [
        "../../packages/openrouter-browser-storage/src/index.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
