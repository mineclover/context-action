{
  "schemaVersion": "source-of-truth-manifest.v1",
  "repository": {
    "name": "context-action",
    "role": "consumer",
    "url": "https://github.com/mineclover/context-action"
  },
  "toolingRepository": {
    "name": "context-action-documentation-tooling",
    "url": "https://github.com/mineclover/context-action-documentation-tooling",
    "phase": "published",
    "remoteStatus": "configured"
  },
  "semContract": {
    "evidenceProvider": "@ataraxy-labs/sem",
    "primaryPackage": "@context-action/sem-doc",
    "foundationPackages": [
      "@context-action/sem-foundation-contracts",
      "@context-action/sem-foundation-repository"
    ],
    "ssotArtifact": "revision-bound-serialized-symbol-context",
    "artifactSchemas": [
      "context-action/symbol-snapshot@1.1",
      "context-action/symbol-snapshot-diff@1.0",
      "sem-doc-work-context.v5",
      "sem-doc-context-scope.v3",
      "sem-doc-context-scope-history.v2",
      "sem-doc-context-scope-history-stream.v1",
      "sem-doc-context-scope-diff.v1",
      "sem-doc-context-scope-branch-compare.v1"
    ],
    "nonGoals": [
      "runtime-call-graph",
      "lsp-exact-reference-locations",
      "architecture-policy-ownership"
    ]
  },
  "publishedPackages": [
    {
      "name": "@context-action/sem-foundation-contracts",
      "version": "0.1.1"
    },
    {
      "name": "@context-action/sem-foundation-repository",
      "version": "0.1.1"
    },
    {
      "name": "@context-action/sem-doc",
      "version": "0.2.0"
    }
  ],
  "consumerOwnedPackages": [
    "@context-action/architecture-governance",
    "@context-action/typedoc-vitepress-sync",
    "@context-action/llms-generator"
  ],
  "generatedArtifacts": [
    "architecture/registry.json",
    "docs/api",
    "llmsData"
  ],
  "publishedArtifactNote": "Corrected 0.1.1 Foundation and 0.2.0 sem-doc artifacts point to the tooling repository and emit the current v5 contract; older 0.1.x artifacts remain legacy history.",
  "cutoverRule": "Consumer uses published tooling packages; no Foundation or sem-doc migration copies remain in the consumer workspace."
}
