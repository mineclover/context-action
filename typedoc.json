{
  "entryPoints": [
    "./packages/core/src/index.ts",
    "./packages/tool-protocol/src/index.ts",
    "./packages/ai-sdk/src/index.ts",
    "./packages/webmcp/src/index.ts",
    "./packages/tool-durable-operations/src/index.ts",
    "./packages/react/src/index.ts",
    "./packages/react/src/tools/index.ts"
  ],
  "tsconfig": "./tsconfig.json",
  "out": "./docs/api/generated",
  "cleanOutputDir": true,
  "plugin": ["typedoc-plugin-markdown"],
  "theme": "markdown",
  "blockTags": [
    "@defaultValue", "@deprecated", "@example", "@jsx", "@param",
    "@privateRemarks", "@remarks", "@returns", "@see", "@throws",
    "@typeParam", "@author", "@callback", "@category", "@categoryDescription",
    "@default", "@document", "@extends", "@augments", "@yields", "@group",
    "@groupDescription", "@import", "@inheritDoc", "@license", "@module",
    "@mergeModuleWith", "@prop", "@property", "@return", "@satisfies", "@since",
    "@sortStrategy", "@template", "@this", "@type", "@typedef", "@summary",
    "@preventInline", "@inlineType", "@preventExpand", "@expandType",
    "@implements", "@memberof"
  ],
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "disableSources": false,
  "sourceLinkTemplate": "https://github.com/mineclover/context-action/blob/main/packages/{path}#L{line}",
  "disableGit": true,
  "includeVersion": true,
  "categorizeByGroup": false,
  "categoryOrder": [
    "Core",
    "Tool Protocol",
    "AI SDK",
    "WebMCP",
    "Tool Durable Operations",
    "React",
    "*"
  ],
  "groupOrder": [
    "Classes",
    "Interfaces", 
    "Type Aliases",
    "Functions",
    "Variables"
  ],
  "sort": ["source-order"],
  "kindSortOrder": [
    "Project",
    "Module",
    "Namespace",
    "Enum",
    "EnumMember",
    "Class",
    "Interface",
    "TypeAlias",
    "Constructor",
    "Property",
    "Variable",
    "Function",
    "Accessor",
    "Method",
    "Parameter",
    "TypeParameter",
    "TypeLiteral",
    "CallSignature",
    "ConstructorSignature",
    "IndexSignature",
    "GetSignature",
    "SetSignature"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test/**/*",
    "**/tests/**/*"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "customCss": "./docs/assets/typedoc-custom.css",
  "navigationLinks": {
    "GitHub": "https://github.com/mineclover/context-action"
  },
  "treatWarningsAsErrors": false,
  "skipErrorChecking": true,
  "basePath": ".",
  "excludeExternals": true,
  "externalSymbolLinkMappings": {
    "@types/react": {
      "React.NewLifecycle.getSnapshotBeforeUpdate": "#"
    }
  },
  "githubPages": false
}
